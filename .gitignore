# Secrets and local environment
**/.env
**/.env.*
!**/.env.example
!**/.env.ci
!**/.env.production.example
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore

# Dependencies and generated builds
**/node_modules/
**/vendor/
**/build/
**/dist/
backend/public/build/
backend/public/hot
backend/public/storage

# Laravel runtime and local databases
backend/database/*.sqlite
backend/bootstrap/cache/*.php
!backend/bootstrap/cache/.gitignore
backend/storage/*.key
backend/storage/framework/**
!backend/storage/framework/**/.gitignore
backend/storage/logs/**
!backend/storage/logs/.gitignore
backend/storage/app/private/**
!backend/storage/app/private/.gitignore
backend/storage/app/public/**
!backend/storage/app/public/.gitignore

# Flutter and platform-local files
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/key.properties
mobile/ios/Flutter/ephemeral/
mobile/ios/Flutter/Generated.xcconfig
mobile/ios/Flutter/flutter_export_environment.sh
mobile/macos/Flutter/ephemeral/
mobile/windows/flutter/ephemeral/
mobile/linux/flutter/ephemeral/

# Python and model artifacts
**/__pycache__/
**/*.py[cod]
ml/models/
ml/output/
**/*.pkl
**/*.pickle
**/*.joblib

# Test, coverage, editor, and OS artifacts
**/.pytest_cache/
**/.phpunit.cache/
**/.phpunit.result.cache
**/coverage/
**/.idea/
**/.vscode/
**/.DS_Store
**/Thumbs.db
*.log
