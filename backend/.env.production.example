APP_NAME="PDAM SaaS"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://pdam.go.id

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pdam
DB_USERNAME=pdam
DB_PASSWORD=secret_change_me

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

SANCTUM_STATEFUL_DOMAINS=pdam.go.id

MIDTRANS_SERVER_KEY=Mid-server-xxx
MIDTRANS_CLIENT_KEY=Mid-client-xxx
MIDTRANS_IS_PRODUCTION=true
MIDTRANS_MERCHANT_ID=Gxxxxx

FCM_SERVER_KEY=AAAAxxx

# Shared only between Laravel/internal infrastructure and the private ML service.
ML_SERVICE_TOKEN=replace-with-a-long-random-secret

CORS_ALLOWED_ORIGINS=https://pdam.go.id,https://admin.pdam.go.id

# ── Least-privilege DB (gate §13 #4; lihat ops/mysql/*.sh + DEPLOY.md) ──
# pdam_app = runtime (DML saja), pdam_audit = INSERT/SELECT privacy_audit_events
# DB_AUDIT_* kosong → connection default dipakai (trigger tetap menegakkan).
DB_AUDIT_USERNAME=pdam_audit
DB_AUDIT_PASSWORD=secret_change_me
DB_AUDIT_DATABASE=pdam

# Super admin PLATFORM dibuat lewat ProductionKernelSeeder (db:seed --class)
# — lewat env, ditolak bila password default demo/too-weak.
PLATFORM_ADMIN_EMAIL=admin@pdam.go.id
PLATFORM_ADMIN_NAME=Platform Administrator
PLATFORM_ADMIN_PASSWORD=ubah-dan-min-12-karakter

# ── Keputusan bisnis (PRD §23) — lihat config/business.php + docs/BUSINESS_DECISIONS.md ──
# ── WIRED (dibaca kode: config/business.php) ──
PDAM_SUBSCRIPTION_GRACE_DAYS=0
PDAM_INSTALL_EXPIRE_HOURS=24
PDAM_INSTALL_CAPITALIZATION_ACCOUNT=1-004
PDAM_INVENTORY_ACCOUNT=1-003
# ── PENDING PRD S23 — TIDAK dibaca kode; daftar & status di
#    ../docs/BUSINESS_DECISIONS.md (trial / digit meter / payment provider
#    kedua / refund) — jangan set env-nya seolah berfungsi.
# DemoGuard kini block produksi MUTLAK: env PDAM_ALLOW_DEMO_SEED tidak ada
# effect lagi di production (review CRITICAL#1).

# ML service dasar (ops/nginx/ml-service.mtls.conf + pdam:integrations-health --ping)
ML_SERVICE_BASE_URL=https://ml.internal.pdam:8443

# PDAM_METER_DIGITS=6 (jumlah digit hitam register PDAM, lihat config/business meter.digits)
