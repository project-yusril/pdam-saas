{
  "info": {
    "name": "PDAM SaaS API v1",
    "description": "Platform manajemen PDAM multi-tenant. Web/platform memakai CSRF + cookie session; mobile/API device mengirim device_name saat login dan memakai bearer Sanctum. Laravel route registry adalah sumber endpoint aktual; OpenAPI dan koleksi ini adalah referensi parsial yang harus divalidasi terhadap registry.\n\nBase URL: {{baseUrl}}/api/v1\n\nKredensial fixture lengkap: backend/SEED_DATA.md.", 
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "pdam-platform"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{"key": "token", "value": "{{authToken}}", "type": "string"}]
  },
  "variable": [
    {"key": "baseUrl", "value": "http://127.0.0.1:8000"},
    {"key": "authToken", "value": ""}
  ],
  "item": [
    {
      "name": "Auth - Web Session and Mobile Bearer",
      "item": [
        {"name": "Web - Bootstrap CSRF Cookie", "request": {"auth":{"type":"noauth"},"method":"GET","url":"{{baseUrl}}/sanctum/csrf-cookie","description":"Jalankan sebelum login web. Aktifkan cookie jar Postman dan gunakan hostname yang sama untuk seluruh flow."}},
        {"name": "Web - Login Tenant Session", "request": {"auth":{"type":"noauth"},"method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": {"mode":"raw","raw":"{\"pdam_code\":\"pdam-canada\",\"email\":\"admin_tenant@gmail.com\",\"password\":\"12345678\"}"}, "url": "{{baseUrl}}/api/v1/login","description":"Tidak mengembalikan token. Gunakan cookie dari CSRF bootstrap dan response login."}},
        {"name": "Web - Check Session", "request": {"auth":{"type":"noauth"},"method":"GET","url":"{{baseUrl}}/api/v1/session"}},
        {"name": "Mobile - Login Tenant Bearer", "request": {"auth":{"type":"noauth"},"method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": {"mode":"raw","raw":"{\"pdam_code\":\"pdam-canada\",\"email\":\"meter_officer@gmail.com\",\"password\":\"12345678\",\"device_name\":\"postman-device\"}"}, "url": "{{baseUrl}}/api/v1/login","description":"Response berisi token karena device_name dikirim. Set nilai token ke variable authToken untuk request bearer."}},
        {"name": "Web - Logout Session", "request": {"auth":{"type":"noauth"},"method": "POST", "url": "{{baseUrl}}/api/v1/logout"}},
        {"name": "Mobile - Logout Bearer", "request": {"method": "POST", "url": "{{baseUrl}}/api/v1/logout"}},
        {"name": "Mobile - Refresh Bearer Token", "request": {"method": "POST", "url": "{{baseUrl}}/api/v1/refresh-token"}}
      ]
    },
    {
      "name": "Auth - Platform Web Session",
      "item": [
        {"name":"Platform - Login Session","request":{"auth":{"type":"noauth"},"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"superadmin@gmail.com\",\"password\":\"12345678\"}"},"url":"{{baseUrl}}/api/v1/platform/login","description":"Jalankan bootstrap CSRF pada folder Auth lebih dahulu. Login platform tidak mengembalikan bearer token."}},
        {"name":"Platform - Logout","request":{"auth":{"type":"noauth"},"method":"POST","url":"{{baseUrl}}/api/v1/platform/logout"}}
      ]
    },
